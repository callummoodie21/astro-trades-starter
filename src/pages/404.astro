---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';
import { site } from '@config';
import { telHref } from '@lib/site';

/**
 * Astro builds this to `dist/404.html`. Cloudflare Pages and Netlify both serve
 * that automatically for unknown paths - no redirect rules, no config.
 */

const { business } = site;
---

<BaseLayout
  title={`Page not found - ${business.legalName}`}
  description="That page doesn't exist."
  noindex
>
  <Header />

  <main id="main" class="section-y">
    <div class="wrap max-w-xl text-center">
      <p class="text-sm font-semibold tracking-wide text-accent-text uppercase">
        404
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-primary sm:text-4xl">
        We can't find that page
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        It may have moved. Head back to the homepage, or just give us a ring -
        that's usually quicker anyway.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" variant="primary" block>Back to the homepage</Button>
        <Button
          href={telHref}
          variant="outline"
          icon="phone"
          block
          aria-label={`Call ${business.name} on ${business.phone.display}`}
        >
          {business.phone.display}
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

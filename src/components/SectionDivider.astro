---
import { site } from '@config';
import type { MotifName } from '@lib/config-types';

/**
 * The per-client visual motif that sits between sections.
 *
 * Set `theme.motif` in site.config.ts to swap it: 'pipe' suits plumbers and
 * heating engineers, 'chevron' suits joiners and builders, 'wave' suits
 * anything softer, 'rule' is the neutral fallback, and 'none' turns it off.
 *
 * All four are inline SVG using `currentColor`, so they pick up the accent
 * colour from the config automatically - one motif, every client, no assets.
 */

interface Props {
  /** Override the config default for a single divider if you want variety. */
  motif?: MotifName;
  /**
   * Set when the divider sits on a feature band (the hero or reviews section)
   * rather than a normal page surface. It then uses the band's accent, which
   * resolves correctly whether `theme.bands` is dark or light.
   */
  onBand?: boolean;
  class?: string;
}

const {
  motif = site.theme.motif,
  onBand = false,
  class: className = '',
} = Astro.props;

const tone = onBand ? 'text-on-band-accent' : 'text-accent';
---

{
  motif !== 'none' && (
    <div
      class:list={['flex justify-center', tone, className]}
      role="presentation"
      aria-hidden="true"
    >
      {motif === 'pipe' && (
        <svg
          viewBox="0 0 240 24"
          class="h-6 w-full max-w-[15rem]"
          fill="none"
          stroke="currentColor"
        >
          <path d="M0 12h84" stroke-width="2" opacity="0.35" />
          <path d="M156 12h84" stroke-width="2" opacity="0.35" />
          <path d="M84 12h18M138 12h18" stroke-width="3" stroke-linecap="round" />
          <rect x="102" y="5" width="36" height="14" rx="3" stroke-width="2.5" />
          <path d="M108 5v14M132 5v14" stroke-width="1.5" opacity="0.6" />
        </svg>
      )}

      {motif === 'chevron' && (
        <svg
          viewBox="0 0 240 24"
          class="h-6 w-full max-w-[15rem]"
          fill="none"
          stroke="currentColor"
        >
          <path d="M0 12h96M144 12h96" stroke-width="2" opacity="0.35" />
          <path
            d="m104 18 8-6-8-6M120 18l8-6-8-6"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}

      {motif === 'wave' && (
        <svg
          viewBox="0 0 240 24"
          class="h-6 w-full max-w-[15rem]"
          fill="none"
          stroke="currentColor"
        >
          <path d="M0 12h72M168 12h72" stroke-width="2" opacity="0.35" />
          <path
            d="M72 12c6-8 12-8 18 0s12 8 18 0 12-8 18 0 12 8 18 0 12-8 18 0"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </svg>
      )}

      {motif === 'rule' && (
        <svg
          viewBox="0 0 240 24"
          class="h-6 w-full max-w-[15rem]"
          fill="none"
          stroke="currentColor"
        >
          <path d="M0 12h104M136 12h104" stroke-width="2" opacity="0.35" />
          <path d="m120 5 7 7-7 7-7-7 7-7Z" stroke-width="2.5" stroke-linejoin="round" />
        </svg>
      )}
    </div>
  )
}

---
import type { IconName } from '@lib/config-types';

/**
 * Inline SVG icons, no icon library.
 *
 * Why hand-roll it: an icon package would add a dependency and (with most of
 * them) a runtime. Here the SVG markup is inlined into the HTML at build time,
 * so there is no extra request, nothing to cache-bust, and no JavaScript.
 *
 * All icons share one 24×24 grid and use `currentColor`, so they inherit
 * whatever text colour their parent has - `text-accent` on the wrapper is all
 * you need to recolour one.
 *
 * They're decorative here (every icon sits next to a real text label), so they
 * get `aria-hidden` and are skipped by screen readers rather than announced as
 * meaningless "image".
 */

interface Props {
  name: IconName;
  class?: string;
  /** Stroke weight. Bump to 2 for small sizes, drop to 1.5 for large. */
  strokeWidth?: number;
  /** Solid rather than outline. Used for the review star ratings. */
  filled?: boolean;
}

const {
  name,
  class: className = 'h-6 w-6',
  strokeWidth = 1.75,
  filled = false,
} = Astro.props;

const paths: Record<IconName, string> = {
  wrench:
    '<path d="M15.6 3.5a5 5 0 0 0-6.4 6.4l-6 6a2 2 0 0 0 0 2.8l2.1 2.1a2 2 0 0 0 2.8 0l6-6a5 5 0 0 0 6.4-6.4l-3.2 3.2-2.9-2.9 3.2-3.2Z"/>',
  flame:
    '<path d="M12 2s6 5 6 10a6 6 0 0 1-12 0c0-2 1-4 2-5 0 2 1 3 2 3 0-3 1-6 2-8Z"/>',
  bath:
    '<path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Z"/><path d="M6 12V5.5a2 2 0 0 1 4 0"/><path d="M5 21l1-2M19 21l-1-2"/>',
  droplet: '<path d="M12 2.7 6.8 8.5a7.3 7.3 0 1 0 10.4 0L12 2.7Z"/>',
  hammer:
    '<path d="m14 6 4-4 4 4-4 4-4-4Z"/><path d="m14.5 6.5-9 9a2.12 2.12 0 0 0 3 3l9-9"/>',
  scissors:
    '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"/>',
  sparkles:
    '<path d="m12 3 1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3Z"/><path d="m19 15 .9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  leaf: '<path d="M4 20c0-9 7-14 16-14 0 9-5 15-14 15H4v-1Z"/><path d="M9 15c2-3 5-5 8-6"/>',
  home: '<path d="m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9Z"/><path d="M9 21v-7h6v7"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7.5 10 6 10-6"/>',
  'map-pin':
    '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  shield:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2L7 14.2l-5-4.9 6.9-1L12 2Z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={filled ? 0 : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
